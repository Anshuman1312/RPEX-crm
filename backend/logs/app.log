	is_deleted BOOLEAN NOT NULL, 
	deleted_at TIMESTAMP WITH TIME ZONE, 
	CONSTRAINT pk_bookings PRIMARY KEY (id), 
	CONSTRAINT uq_unit_active_booking UNIQUE (unit_id, is_deleted), 
	CONSTRAINT fk_bookings_unit_id_units FOREIGN KEY(unit_id) REFERENCES units (id), 
