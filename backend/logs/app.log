CREATE TABLE tasks (
	task_number VARCHAR(20) NOT NULL, 
	title VARCHAR(255) NOT NULL, 
	description TEXT, 
	task_type VARCHAR(50) NOT NULL, 
	category VARCHAR(50) NOT NULL, 
	status taskstatus NOT NULL, 
	priority taskpriority NOT NULL, 
	assigned_to_user_id UUID, 
	created_by_user_id UUID NOT NULL, 
	due_date TIMESTAMP WITHOUT TIME ZONE, 
	start_date TIMESTAMP WITHOUT TIME ZONE, 
	completed_at TIMESTAMP WITHOUT TIME ZONE, 
	estimated_hours NUMERIC(10, 2), 
	actual_hours NUMERIC(10, 2), 
	progress INTEGER NOT NULL, 
	lead_id UUID, 
	customer_id UUID, 
	project_id UUID, 
	booking_id UUID, 
	tags JSON NOT NULL, 
	attachments_urls JSON NOT NULL, 
	is_urgent BOOLEAN NOT NULL, 
	is_recurring BOOLEAN NOT NULL, 
	id UUID NOT NULL, 
	created_at TIMESTAMP WITH TIME ZONE DEFAULT now() NOT NULL, 
	updated_at TIMESTAMP WITH TIME ZONE DEFAULT now() NOT NULL, 
	updated_by UUID, 
	is_deleted BOOLEAN NOT NULL, 
	deleted_at TIMESTAMP WITH TIME ZONE, 
	CONSTRAINT pk_tasks PRIMARY KEY (id), 
	CONSTRAINT fk_tasks_assigned_to_user_id_users FOREIGN KEY(assigned_to_user_id) REFERENCES users (id) ON DELETE SET NULL, 
	CONSTRAINT fk_tasks_created_by_user_id_users FOREIGN KEY(created_by_user_id) REFERENCES users (id) ON DELETE SET NULL, 
	CONSTRAINT fk_tasks_lead_id_leads FOREIGN KEY(lead_id) REFERENCES leads (id) ON DELETE SET NULL, 
	CONSTRAINT fk_tasks_customer_id_customers FOREIGN KEY(customer_id) REFERENCES customers (id) ON DELETE SET NULL, 
