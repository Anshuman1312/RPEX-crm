CREATE TABLE task_attachments (
	task_id UUID NOT NULL, 
	filename VARCHAR(255) NOT NULL, 
	file_url TEXT NOT NULL, 
	file_size INTEGER, 
	mime_type VARCHAR(100), 
	uploaded_by_user_id UUID NOT NULL, 
	description TEXT, 
	id UUID NOT NULL, 
	created_at TIMESTAMP WITH TIME ZONE DEFAULT now() NOT NULL, 
	updated_at TIMESTAMP WITH TIME ZONE DEFAULT now() NOT NULL, 
	created_by UUID, 
	updated_by UUID, 
	is_deleted BOOLEAN NOT NULL, 
	deleted_at TIMESTAMP WITH TIME ZONE, 
	CONSTRAINT pk_task_attachments PRIMARY KEY (id), 
	CONSTRAINT fk_task_attachments_task_id_tasks FOREIGN KEY(task_id) REFERENCES tasks (id) ON DELETE CASCADE, 
	CONSTRAINT fk_task_attachments_uploaded_by_user_id_users FOREIGN KEY(uploaded_by_user_id) REFERENCES users (id) ON DELETE SET NULL, 
	CONSTRAINT fk_task_attachments_created_by_users FOREIGN KEY(created_by) REFERENCES users (id) ON DELETE SET NULL, 
	CONSTRAINT fk_task_attachments_updated_by_users FOREIGN KEY(updated_by) REFERENCES users (id) ON DELETE SET NULL
)


