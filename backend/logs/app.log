CREATE TABLE invoices (
	invoice_number VARCHAR(50) NOT NULL, 
	booking_id UUID, 
	customer_id UUID NOT NULL, 
	project_id UUID, 
	invoice_date TIMESTAMP WITHOUT TIME ZONE NOT NULL, 
	due_date TIMESTAMP WITHOUT TIME ZONE NOT NULL, 
	subtotal NUMERIC(15, 2) NOT NULL, 
	gst_amount NUMERIC(15, 2) NOT NULL, 
	total_amount NUMERIC(15, 2) NOT NULL, 
	paid_amount NUMERIC(15, 2) NOT NULL, 
	payment_status VARCHAR(50) NOT NULL, 
	invoice_status VARCHAR(50) NOT NULL, 
	notes TEXT, 
	invoice_url VARCHAR(255), 
	sent_on TIMESTAMP WITHOUT TIME ZONE, 
	paid_on TIMESTAMP WITHOUT TIME ZONE, 
	id UUID NOT NULL, 
	created_at TIMESTAMP WITH TIME ZONE DEFAULT now() NOT NULL, 
	updated_at TIMESTAMP WITH TIME ZONE DEFAULT now() NOT NULL, 
	created_by UUID, 
	updated_by UUID, 
	is_deleted BOOLEAN NOT NULL, 
	deleted_at TIMESTAMP WITH TIME ZONE, 
	CONSTRAINT pk_invoices PRIMARY KEY (id), 
	CONSTRAINT fk_invoices_booking_id_bookings FOREIGN KEY(booking_id) REFERENCES bookings (id), 
	CONSTRAINT fk_invoices_customer_id_customers FOREIGN KEY(customer_id) REFERENCES customers (id), 
	CONSTRAINT fk_invoices_project_id_projects FOREIGN KEY(project_id) REFERENCES projects (id), 
	CONSTRAINT fk_invoices_created_by_users FOREIGN KEY(created_by) REFERENCES users (id) ON DELETE SET NULL, 
	CONSTRAINT fk_invoices_updated_by_users FOREIGN KEY(updated_by) REFERENCES users (id) ON DELETE SET NULL
)


