CREATE TABLE bookings (
	booking_number VARCHAR(50) NOT NULL, 
	unit_id UUID NOT NULL, 
	customer_id UUID NOT NULL, 
	booking_date TIMESTAMP WITHOUT TIME ZONE NOT NULL, 
	booking_amount NUMERIC(15, 2) NOT NULL, 
