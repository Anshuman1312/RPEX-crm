	CONSTRAINT fk_booking_cancellations_created_by_users FOREIGN KEY(created_by) REFERENCES users (id) ON DELETE SET NULL, 
	CONSTRAINT fk_booking_cancellations_updated_by_users FOREIGN KEY(updated_by) REFERENCES users (id) ON DELETE SET NULL
)


