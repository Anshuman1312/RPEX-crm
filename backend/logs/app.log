	payment_status VARCHAR(50) NOT NULL, 
	invoice_status VARCHAR(50) NOT NULL, 
	notes TEXT, 
	invoice_url VARCHAR(255), 
	sent_on TIMESTAMP WITHOUT TIME ZONE, 
	paid_on TIMESTAMP WITHOUT TIME ZONE, 
	id UUID NOT NULL, 
	created_at TIMESTAMP WITH TIME ZONE DEFAULT now() NOT NULL, 
	updated_at TIMESTAMP WITH TIME ZONE DEFAULT now() NOT NULL, 
	created_by UUID, 
	updated_by UUID, 
	is_deleted BOOLEAN NOT NULL, 
	deleted_at TIMESTAMP WITH TIME ZONE, 
	CONSTRAINT pk_invoices PRIMARY KEY (id), 
	CONSTRAINT fk_invoices_booking_id_bookings FOREIGN KEY(booking_id) REFERENCES bookings (id), 
	CONSTRAINT fk_invoices_customer_id_customers FOREIGN KEY(customer_id) REFERENCES customers (id), 
