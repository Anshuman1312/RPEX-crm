	approval_status VARCHAR(50) NOT NULL, 
	approval_completed_at TIMESTAMP WITHOUT TIME ZONE, 
	related_lead_id UUID, 
	confirmed_by_user_id UUID, 
	confirmed_at TIMESTAMP WITHOUT TIME ZONE, 
	cancellation_initiated_at TIMESTAMP WITHOUT TIME ZONE, 
	cancellation_reason TEXT, 
	id UUID NOT NULL, 
	created_at TIMESTAMP WITH TIME ZONE DEFAULT now() NOT NULL, 
	updated_at TIMESTAMP WITH TIME ZONE DEFAULT now() NOT NULL, 
	created_by UUID, 
	updated_by UUID, 
	is_deleted BOOLEAN NOT NULL, 
	deleted_at TIMESTAMP WITH TIME ZONE, 
	CONSTRAINT pk_bookings PRIMARY KEY (id), 
	CONSTRAINT uq_unit_active_booking UNIQUE (unit_id, is_deleted), 
	CONSTRAINT fk_bookings_unit_id_units FOREIGN KEY(unit_id) REFERENCES units (id), 
	CONSTRAINT fk_bookings_customer_id_customers FOREIGN KEY(customer_id) REFERENCES customers (id), 
	CONSTRAINT fk_bookings_assignment_to_user_id_users FOREIGN KEY(assignment_to_user_id) REFERENCES users (id), 
	CONSTRAINT fk_bookings_related_lead_id_leads FOREIGN KEY(related_lead_id) REFERENCES leads (id), 
	CONSTRAINT fk_bookings_confirmed_by_user_id_users FOREIGN KEY(confirmed_by_user_id) REFERENCES users (id), 
	CONSTRAINT fk_bookings_created_by_users FOREIGN KEY(created_by) REFERENCES users (id) ON DELETE SET NULL, 
	CONSTRAINT fk_bookings_updated_by_users FOREIGN KEY(updated_by) REFERENCES users (id) ON DELETE SET NULL
)


