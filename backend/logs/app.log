CREATE TABLE projects (
	project_number VARCHAR(50) NOT NULL, 
	name VARCHAR(255) NOT NULL, 
	description TEXT, 
	location VARCHAR(500) NOT NULL, 
	city VARCHAR(100) NOT NULL, 
	state VARCHAR(100) NOT NULL, 
	postal_code VARCHAR(20), 
	latitude NUMERIC(10, 8), 
	longitude NUMERIC(11, 8), 
	developer_id VARCHAR(36), 
	launch_date TIMESTAMP WITHOUT TIME ZONE, 
	completion_date TIMESTAMP WITHOUT TIME ZONE, 
	status VARCHAR(50) NOT NULL, 
	construction_status INTEGER, 
	total_units INTEGER, 
	sold_units INTEGER, 
	available_units INTEGER, 
	total_area_sqft NUMERIC(12, 2), 
	total_land_area_sqft NUMERIC(12, 2), 
	amenities VARCHAR(2000), 
	unit_types VARCHAR(500), 
	avg_price_per_sqft NUMERIC(10, 2), 
	brochure_url VARCHAR(500), 
	id UUID NOT NULL, 
	created_at TIMESTAMP WITH TIME ZONE DEFAULT now() NOT NULL, 
	updated_at TIMESTAMP WITH TIME ZONE DEFAULT now() NOT NULL, 
	created_by UUID, 
	updated_by UUID, 
	is_deleted BOOLEAN NOT NULL, 
	deleted_at TIMESTAMP WITH TIME ZONE, 
	CONSTRAINT pk_projects PRIMARY KEY (id), 
	CONSTRAINT fk_projects_developer_id_vendors FOREIGN KEY(developer_id) REFERENCES vendors (id) ON DELETE SET NULL, 
	CONSTRAINT fk_projects_created_by_users FOREIGN KEY(created_by) REFERENCES users (id) ON DELETE SET NULL, 
